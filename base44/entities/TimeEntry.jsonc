{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time"
    },
    "regular_hours": {
      "type": "number"
    },
    "overtime_hours": {
      "type": "number"
    },
    "drive_time_hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "submitted",
        "approved",
        "locked"
      ],
      "default": "open"
    },
    "approved_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "employee_name"
  ]
}