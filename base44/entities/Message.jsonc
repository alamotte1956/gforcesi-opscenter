{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "app",
        "email"
      ],
      "default": "app"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "body"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}