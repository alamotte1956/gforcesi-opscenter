{
  "name": "Contractor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Field Technician",
        "Field Pilot",
        "Dispatcher",
        "Billing Manager",
        "Admin"
      ],
      "default": "Field Technician"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "flat",
        "salary"
      ],
      "default": "hourly"
    },
    "pay_rate": {
      "type": "number"
    },
    "quickbooks_id": {
      "type": "string"
    },
    "shift_status": {
      "type": "string",
      "enum": [
        "on_duty",
        "off_duty",
        "on_break"
      ],
      "default": "off_duty"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "available",
        "en_route",
        "on_site",
        "off_duty"
      ],
      "default": "off_duty"
    },
    "current_latitude": {
      "type": "number"
    },
    "current_longitude": {
      "type": "number"
    },
    "current_job_id": {
      "type": "string"
    },
    "current_job_title": {
      "type": "string"
    },
    "eta_minutes": {
      "type": "number"
    },
    "region": {
      "type": "string"
    },
    "location_sharing": {
      "type": "boolean",
      "default": false
    },
    "slack_channel": {
      "type": "string"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending"
    },
    "w9_on_file": {
      "type": "boolean",
      "default": false
    },
    "contract_signed": {
      "type": "boolean",
      "default": false
    },
    "insurance_on_file": {
      "type": "boolean",
      "default": false
    },
    "mn_ic_exemption_on_file": {
      "type": "boolean",
      "default": false
    },
    "workers_comp_on_file": {
      "type": "boolean",
      "default": false
    },
    "esign_consent": {
      "type": "boolean",
      "default": false
    },
    "emergency_contact": {
      "type": "string"
    },
    "onboarded_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}