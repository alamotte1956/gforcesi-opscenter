{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Admin",
        "Dispatcher",
        "Billing Manager",
        "Field Technician",
        "Field Pilot"
      ],
      "default": "Field Technician"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "salary"
      ],
      "default": "hourly"
    },
    "pay_rate": {
      "type": "number"
    },
    "quickbooks_employee_id": {
      "type": "string"
    },
    "shift_status": {
      "type": "string",
      "enum": [
        "on_duty",
        "off_duty",
        "on_break"
      ],
      "default": "off_duty"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "available",
        "en_route",
        "on_site",
        "off_duty"
      ],
      "default": "off_duty"
    },
    "current_latitude": {
      "type": "number"
    },
    "current_longitude": {
      "type": "number"
    },
    "current_job_id": {
      "type": "string"
    },
    "current_job_title": {
      "type": "string"
    },
    "eta_minutes": {
      "type": "number"
    },
    "region": {
      "type": "string"
    },
    "location_sharing": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "role"
  ]
}