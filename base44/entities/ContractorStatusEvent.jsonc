{
  "name": "ContractorStatusEvent",
  "type": "object",
  "properties": {
    "contractor_id": {
      "type": "string"
    },
    "contractor_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "status_change",
        "shift_clock_in",
        "shift_clock_out",
        "location_update",
        "anomaly"
      ],
      "default": "status_change"
    },
    "status": {
      "type": "string"
    },
    "shift_status": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contractor_id",
    "event_type",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}