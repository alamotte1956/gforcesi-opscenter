{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "billing_contact_name": {
      "type": "string"
    },
    "billing_email": {
      "type": "string"
    },
    "billing_phone": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "terms": {
      "type": "string",
      "enum": [
        "Net 15",
        "Net 30",
        "Net 45",
        "Due on Receipt"
      ],
      "default": "Net 30"
    },
    "default_rate": {
      "type": "number"
    },
    "quickbooks_customer_id": {
      "type": "string"
    },
    "portal_email": {
      "type": "string"
    },
    "portal_access_level": {
      "type": "string",
      "enum": [
        "none",
        "limited",
        "full"
      ],
      "default": "none"
    },
    "opening_time": {
      "type": "string"
    },
    "closing_time": {
      "type": "string"
    },
    "access_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}