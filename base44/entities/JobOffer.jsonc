{
  "name": "JobOffer",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "contractor_id": {
      "type": "string"
    },
    "contractor_name": {
      "type": "string"
    },
    "contractor_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "accepted",
        "declined",
        "expired"
      ],
      "default": "offered"
    },
    "offered_at": {
      "type": "string",
      "format": "date-time"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time"
    },
    "scan_window_start": {
      "type": "string"
    },
    "scan_window_end": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "estimated_duration_hours": {
      "type": "number"
    },
    "billable_rate_type": {
      "type": "string",
      "enum": [
        "hourly",
        "per_sqft",
        "flat",
        "daily"
      ],
      "default": "hourly"
    },
    "billable_rate": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "job_title",
    "contractor_id",
    "contractor_name",
    "contractor_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.contractor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.contractor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}