{
  "name": "JobContract",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "contractor_id": {
      "type": "string"
    },
    "contractor_name": {
      "type": "string"
    },
    "contractor_email": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "signed",
        "declined"
      ],
      "default": "pending"
    },
    "terms": {
      "type": "string"
    },
    "billable_rate_type": {
      "type": "string"
    },
    "billable_rate": {
      "type": "number"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_name": {
      "type": "string"
    },
    "esign_consent": {
      "type": "boolean",
      "default": false
    },
    "insurance_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "irs_acknowledged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "job_id",
    "job_title",
    "contractor_id",
    "contractor_name",
    "contractor_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.contractor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.contractor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}