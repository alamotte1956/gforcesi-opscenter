{
  "description": "Emails admins and management a daily summary of activity and watch areas at 8am CT.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Ops Report",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_ops_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyReport"
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily ops report",
            "description": "Compile & email activity + watch areas"
          }
        }
      }
    ]
  }
}